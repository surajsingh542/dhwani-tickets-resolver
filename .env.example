# ── Hub ───────────────────────────────────────────────────────────────
HUB_BASE_URL=https://hub.dhwaniris.com
HUB_PROJECT=ICIC/P382-02
# Session cookie copied from the browser (DevTools → Application → Cookies, or the Cookie request header).
# Either the full header ("sid=...; system_user=yes; ...") or just the sid value. Prefer HUB_COOKIE_FILE.
HUB_COOKIE=
HUB_COOKIE_FILE=

# ── Repository ────────────────────────────────────────────────────────
# A single git repo, or a folder containing several repos (e.g. backend/, frontend/)
REPO_PATH=/absolute/path/to/your/repo-or-folder-of-repos
# Primary repo by folder name (e.g. the Frappe app "icicif" inside bench/apps). Optional.
MAIN_APP=
BASE_BRANCH=development
GIT_REMOTE=origin
# Ticket branch = BRANCH_PREFIX + ticket id (e.g. "fix/" → fix/TASK-2026-00123)
BRANCH_PREFIX=

# ── Ticket selection ──────────────────────────────────────────────────
# Only tickets assigned to / created by these people (email, full name or "me"; comma-separated). Empty = everyone.
ASSIGNEE=
CREATED_BY=
PRIORITIES=P0,P1,P2
TYPE_ORDER=Bug,Enhancement,Change Request,Feature,Task
PICK_STATUSES=Open,Reopen,Reopened,Re-open,Re-opened
RESOLVED_STAGE=To Test
CLARIFICATION_STAGE=Review

# ── Hub writes ────────────────────────────────────────────────────────
HUB_WRITE=true
POST_CLARIFICATION_COMMENT=true
POST_RESOLUTION_COMMENT=false

# ── Claude ────────────────────────────────────────────────────────────
# Uses your installed, logged-in `claude` CLI. Leave empty to use its default model.
CLAUDE_MODEL=
CLAUDE_EXECUTABLE=
# Second turn per ticket where Claude reviews its diff against every requirement before commit
VERIFY_PASS=true
TICKET_TIMEOUT_MINUTES=60
# Progress summary printed to the terminal every N minutes (0 = off)
PROGRESS_INTERVAL_MINUTES=5
# After each ticket, re-run `bench migrate` / `bench build` on development when it touched schema or front-end files
BENCH_SYNC=true

# Optional hard gate run by the orchestrator on the ticket branch and again on development after merge
TEST_COMMAND=
# Per-repo override (JSON, keyed by folder name relative to REPO_PATH; "" skips a repo)
TEST_COMMANDS=
TEST_TIMEOUT_MINUTES=20
MAX_FIX_ATTEMPTS=1

# ── Context download ──────────────────────────────────────────────────
MAX_DOWNLOAD_MB=25
FETCH_EXTERNAL_LINKS=true

WORKSPACE_DIR=./workspace
PORT=3000
