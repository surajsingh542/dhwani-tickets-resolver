# Every value below is the built-in default: leaving a line out (or empty) behaves exactly the same.
# Tags show where else an option can be set for a single run (they override this file):
#   [UI]  = dashboard field      [CLI --x] = command-line flag      (untagged = only here)

# ── Hub ───────────────────────────────────────────────────────────────
HUB_BASE_URL=https://hub.dhwaniris.com
# Project code, e.g. ICIC/P382-02                                       [UI] [CLI --project]
HUB_PROJECT=
# Session cookie: the full Cookie header ("sid=...; system_user=yes; ...") or just the sid value.
# Prefer HUB_COOKIE_FILE so the cookie is not stored in this file.     [UI] [CLI --cookie-file]
HUB_COOKIE=
HUB_COOKIE_FILE=

# ── Repository ────────────────────────────────────────────────────────
# A single git repo, or a folder containing repos at any depth (e.g. a Frappe bench)   [UI] [CLI --repo]
REPO_PATH=
# Main repo by folder name, e.g. the Frappe app "icicif". When set, it is the only repo that is
# pulled, branched, committed, pushed and merged; everything else is read-only.        [UI] [CLI --main-app]
MAIN_APP=
BASE_BRANCH=development
GIT_REMOTE=origin
# Ticket branch = BRANCH_PREFIX + ticket id (e.g. "fix/" → fix/TASK-2026-00123)
BRANCH_PREFIX=

# ── Ticket selection ──────────────────────────────────────────────────
# Only tickets assigned to / created by these people: email, full name or "me", comma-separated.
# Both set = a ticket must match both. Empty = every ticket.           [UI] [CLI --assignee / --created-by]
ASSIGNEE=
CREATED_BY=
# Pick order; narrow per run with --priorities / --types or the dashboard checkboxes.
# Add "none" to also pick tickets that have no priority assigned (e.g. P0,P1,P2,none).
PRIORITIES=P0,P1,P2
# Add "none" to also pick tickets that have no type set
TYPE_ORDER=Bug,Enhancement,Change Request,Feature,Task
PICK_STATUSES=Open,Reopen,Reopened,Re-open,Re-opened
RESOLVED_STAGE=To Test
CLARIFICATION_STAGE=Review

# ── Hub writes ────────────────────────────────────────────────────────
# false = never change stages or post comments                         [UI] [CLI --no-hub-write]
HUB_WRITE=true
# Post clarification questions to the ticket's discussion (tagging its creator)
POST_CLARIFICATION_COMMENT=true
# Also post a short note when a ticket is resolved (tagging its creator)
POST_RESOLUTION_COMMENT=false

# ── Claude ────────────────────────────────────────────────────────────
# Uses your installed, logged-in `claude` CLI. Empty = the CLI's default model.     [CLI --model]
CLAUDE_MODEL=
# Path to the claude executable. Empty = found on PATH (`which claude`).
CLAUDE_EXECUTABLE=
# Set to 1 to let the session use ANTHROPIC_API_KEY instead of the CLI's own login.
USE_ANTHROPIC_API_KEY=
# Second turn per ticket where Claude reviews its diff against every requirement before commit
VERIFY_PASS=true
# When Claude's usage limit is hit: pause until its reset time, then continue (false = stop the run)
WAIT_ON_USAGE_LIMIT=true
# Develop several tickets at once, each in its own git worktree + Claude session; bench checks and merges stay
# one at a time (merge queue).                                          [UI] [CLI --parallel]
PARALLEL=false
# A new Claude conversation for every ticket (fewer tokens); false = one conversation for the whole run   [UI] [CLI --shared-session]
SESSION_PER_TICKET=true
# How many tickets are developed at once in parallel mode               [UI] [CLI --max-concurrent]
MAX_CONCURRENT=3
# Parallel mode: time box for the bench-verification step in the merge queue (other tickets wait on it), minutes
LANE_VERIFY_MINUTES=30
# A single Claude turn is interrupted after this long
TICKET_TIMEOUT_MINUTES=60
# Limits for one shell command inside the session (Frappe test suites can be slow), in ms
BASH_DEFAULT_TIMEOUT_MS=1800000
BASH_MAX_TIMEOUT_MS=1800000
# Progress summary every N minutes (0 = off)                            [UI] [CLI --progress-interval]
PROGRESS_INTERVAL_MINUTES=5

# ── Tests, hooks and the bench ────────────────────────────────────────
# Optional hard test gate, run on the ticket branch and again on the base branch after merge   [UI] [CLI --test-command]
TEST_COMMAND=
# Per-repo override as JSON keyed by folder name relative to REPO_PATH ("" skips a repo),
# e.g. {"dhwani-bench/apps/icicif":"cd ../.. && bench --site icicif.localhost run-tests --app icicif"}
TEST_COMMANDS=
TEST_TIMEOUT_MINUTES=20
# How many times Claude may fix failing tests / pre-commit findings before the ticket is given up
MAX_FIX_ATTEMPTS=1
# After each ticket, `bench migrate` / `bench build` on the base branch when it touched schema or front-end files
BENCH_SYNC=true
# After the tickets, fix test failures Claude proved pre-existing, each on its own branch   [UI] [CLI --no-fix-preexisting]
FIX_PREEXISTING_FAILURES=true

# ── Context download ──────────────────────────────────────────────────
MAX_DOWNLOAD_MB=25
# Download URLs found in tickets (Google Docs/Sheets/Drive via their export links when public)
FETCH_EXTERNAL_LINKS=true

# ── Local paths ───────────────────────────────────────────────────────
WORKSPACE_DIR=./workspace
# Dashboard port (npm start); it only listens on 127.0.0.1
PORT=3000
